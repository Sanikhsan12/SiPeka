generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("citizen") // "citizen" or "admin"
  reports   Report[]
  createdAt DateTime @default(now())
}

model Report {
  id             String   @id @default(uuid())
  title          String
  description    String
  category       String
  incidentDate   DateTime
  location       String
  contactDetails String
  imageUrl       String?
  status         String   @default("Menunggu Peninjauan") // "Menunggu Peninjauan", "Sedang dalam Proses Penyelidikan", "Selesai"
  adminReply     String?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
}
